install.packages("readxl")
library(readxl)
library(fpp2)
library(smooth)
#Load data
retaildata = read_excel("retail.xlsx", skip=1)
#create time series
tsretail = ts(retaildata$A3349462J, start = c(1982,4), freq=12) # liquor sales
#Q1.
autoplot(tsretail)
#Q2.
autoplot(decompose(tsretail, type = "multiplicative"))
autoplot(tsretail)
ggtitle("Daily Average Flight Prices") +
xlab("Time") +
ylab("Average Total Fare ($)")
autoplot(tsretail, xlab = "Time", ylab = "Turnover",
main = "Turnover over time")
#Q3.
train_data = window(tsretail, end=c(2011,12))
test_data = window(tsretail, start=c(2012,1))
#Q4.
retail.naive = naive(train_data, h=24)
retail.ave   = meanf(train_data, h=24)
retail.drift = rwf(train_data, h=24)
retail.sma   = sma(train_data, h=24)
retail.ses   = ses(train_data, h=24)
retail.ets   = forecast(train_data, h=24)
autoplot(tsretail) +
autolayer(retail.naive$mean, series = "Naive") +
autolayer(retail.ave$mean, series = "Average") +
autolayer(retail.drift$mean, series = "Drift") +
autolayer(retail.sma$forecast, series = "SMA") +
autolayer(retail.ses$mean, series = "SES") +
autolayer(retail.ets$mean, series = "ETS")
#Q3.
train_data = window(tsretail, end=c(2011,12))
test_data = window(tsretail, start=c(2012,1))
#Q4.
retail.naive = naive(train_data, h=24)
retail.ave   = meanf(train_data, h=24)
retail.drift = rwf(train_data,drift = TRUE, h=24)
retail.sma   = sma(train_data, h=24)
retail.ses   = ses(train_data, h=24)
retail.ets   = forecast(train_data, h=24)
autoplot(tsretail) +
autolayer(retail.naive$mean, series = "Naive") +
autolayer(retail.ave$mean, series = "Average") +
autolayer(retail.drift$mean, series = "Drift") +
autolayer(retail.sma$forecast, series = "SMA") +
autolayer(retail.ses$mean, series = "SES") +
autolayer(retail.ets$mean, series = "ETS")
accuracy(retail.naive$mean, test_data)
accuracy(retail.ave$mean, test_data)
accuracy(retail.drift$mean, test_data)
accuracy(retail.sma$forecast, test_data)
accuracy(retail.ses$mean, test_data)
accuracy(retail.ets$mean, test_data)
